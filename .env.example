BACKEND_BASE_URL=http://localhost:8080
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=local-nextauth-secret-change-me-32-bytes
APP_ENV=local
NEXT_PUBLIC_APP_NAME=BlindPulse Replay Lab

# Public base URL used for canonical links, robots.txt, sitemap.xml, and Open Graph/Twitter
# metadata (SEO). Must be the real production origin, no trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# OAuth client from Google Cloud Console (Credentials > OAuth 2.0 Client IDs). Register
# ${NEXTAUTH_URL}/api/auth/callback/google as an authorized redirect URI. GOOGLE_CLIENT_ID must
# match the blindpulse-be GOOGLE_CLIENT_ID exactly - the backend verifies tokens against it as the
# expected audience. Leave both empty to disable the "Continue with Google" button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
